# APP_ENV controls which database/auth backend is used.
# Set to "dev" to use local postgres. Set to "prod" to use Supabase.
APP_ENV=dev

PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- Dev (APP_ENV=dev) ---
DATABASE_URL=postgres://routine:routine@localhost:5432/routine
JWT_SECRET=change_this_secret_in_prod

# --- Prod (APP_ENV=prod) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
