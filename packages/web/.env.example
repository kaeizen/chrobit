# VITE_AUTH_MODE controls how the frontend authenticates.
# "local" = call /api/auth/login (dev). "supabase" = use Supabase client (prod).
VITE_AUTH_MODE=local

# API proxy target (used by vite.config.ts dev server, not the browser).
# Set to http://api:3000 when running inside Docker.
# API_PROXY_TARGET=http://localhost:3000

# --- Prod (VITE_AUTH_MODE=supabase) ---
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
